<%# Override of CSS 7.3.0 identity/oidc/consent.html.ejs (upstream-baseline.sha256).
    Kept from stock: every id, name and the consent flow in consent().
    Changed: copy; focus starts on the heading (#authorize is disabled at load and
    cannot take autofocus); the WebID list is sorted, labelled for reading and
    pre-selects the WebID last authorized in this browser; client name and ID are
    inserted as text, not markup (stock inserts the app's own metadata as HTML).
    Added: #client-origin, where the app runs (solid-kit ADR 010, point 6);
    #agents, a closed "Your agents" list for the WebIDs another listed WebID
    declares as its agent (acl:delegates, read from the public profiles). -%>
<h1 tabindex="-1" autofocus>An app wants to use your pod</h1>
<p class="error" id="error"></p>
<p class="intro">
  If you authorize it, this app can read and change the data in your pod,
  acting as the WebID you choose below. Only authorize apps you recognise.
</p>
<div id="client-origin" class="client-origin"></div>
<div style="display: flex;">
  <img id="client_logo" width="40" height="40" style="margin-top: 1em; padding-left: 2em; visibility: collapse;">
  <dl id="client" style="text-wrap: nowrap;"></dl>
</div>
<form method="post" id="mainForm">
  <fieldset>
    <legend>Choose the WebID — your name on the web — this app will act as</legend>
    <ol id="webIdList">
    </ol>
    <details id="agents" class="agents" hidden>
      <summary>Your agents (<span id="agentCount"></span>)</summary>
      <p class="hint">
        Programs that act for you, such as an assistant connected to your pod.
        An app you sign in to should normally get your own WebID, not one of theirs.
      </p>
      <ol id="agentList"></ol>
    </details>
  </fieldset>

  <fieldset>
    <ol>
      <li class="checkbox">
        <label><input type="checkbox" name="remember" value="true" checked>Let this app stay signed in</label>
      </li>
    </ol>
  </fieldset>

  <p class="actions">
    <button id="authorize" type="submit" disabled>Authorize</button>
    <button id="cancel" type="button">Cancel</button>
    <button id="edit-account" type="button" class="alternate">Edit account</button>
    <button id="switch-account" type="button" class="alternate">Use a different account</button>
  </p>

  <p id="recoverWebId">
    If an app can't read or use a WebID that lives in one of your pods, stop here:
    <a id="recover-webid" href="" class="link">repair it first</a> from your account.
  </p>
</form>

<script>
  // Wire up elements
  const elements = getElements();

  // This browser's last authorized WebID, pre-selected next time. A convenience
  // only: the person still presses Authorize, and a WebID no longer on the
  // account is simply not found.
  const LAST_WEBID_KEY = 'pod-consent:last-webid';

  // Retrieve and display client information
  (async() => {
    const controls = await fetchControls('<%= idpIndex %>');

    wireButtons(controls);

    const { webIds } = await fetchJson(controls.oidc.webId);
    if (webIds.length === 0) {
      setError('No WebIDs are assigned to this account. Edit the account to add one.');
    }
    setVisibility('authorize', webIds.length > 0);

    let last = null;
    try { last = localStorage.getItem(LAST_WEBID_KEY); } catch { /* storage blocked */ }
    const preselected = webIds.length === 1 ? webIds[0] : (webIds.includes(last) ? last : null);

    // List WebIDs on page, grouped by pod, the pod's own card first; the
    // account's agents apart, in a closed list (issue #25).
    const agents = await findAgents(webIds);
    const agentList = document.getElementById('agentList');
    for (const webId of sortWebIds(webIds)) {
      const li = document.createElement('li');
      li.className = 'radio';
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'webId';
      input.value = webId;
      input.checked = webId === preselected;
      label.append(input, webIdLabel(webId));
      li.append(label);
      (agents.has(webId) ? agentList : webIdList).append(li);
    }
    if (agents.size > 0) {
      const box = document.getElementById('agents');
      document.getElementById('agentCount').textContent = agents.size;
      box.hidden = false;
      // Last time this browser chose an agent: show it, never a hidden choice.
      box.open = agents.has(preselected);
    }

    const { client } = await fetchJson(controls.oidc.consent);
    const origin = clientOrigin(client.client_id);
    showClientOrigin(origin);
    showClientInfo(origin ? 'Calls itself' : 'Calls itself (unchecked)', client.client_name);
    showClientInfo('Client ID', client.client_id);
    showClientLogo(client.logo_uri, `[${client.client_name} Logo]`);

    addPostListener(() => consent(controls));
  })();

  // Which listed WebIDs are agents: a WebID is an agent when another listed
  // WebID's public profile says `<person> acl:delegates <it>` (the MCP
  // connector writes that in the person's card for each agent it makes). An
  // agent has no pod of its own and acts for the person, so signing in to an
  // app *as* it is almost never what someone means; it is kept, not removed
  // (a test or an admin may want it).
  // Bounded and cautious:
  // - only this server's WebIDs are read: another server is not told that
  //   someone is signing in here;
  // - at most AGENT_FETCH_MAX profiles, AGENT_FETCH_MS in all, without
  //   cookies; whatever is not read in time counts as "not an agent";
  // - a WebID is only ever moved on what a profile *says*, never because a
  //   fetch failed: a failure leaves the list as it was before.
  // N-Triples, one triple per line, so no RDF library in the page; CSS
  // converts the profile to it. The WebIDs are still not parsed for logic:
  // the host test only decides whom to ask, and the URIs are compared whole.
  const AGENT_FETCH_MAX = 12;
  const AGENT_FETCH_MS = 3000;
  const DELEGATES = 'http://www.w3.org/ns/auth/acl#delegates';
  async function findAgents(webIds) {
    const agents = new Set();
    if (webIds.length < 2) return agents;
    const listed = new Set(webIds);
    const ours = (webId) => {
      try {
        const { host } = new URL(webId);
        return host === location.host || host.endsWith(`.${location.host}`);
      } catch { return false; }
    };
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), AGENT_FETCH_MS);
    const read = async(webId) => {
      try {
        // fetch() drops the #fragment: this is the profile document.
        const res = await fetch(webId, { headers: { accept: 'application/n-triples' }, credentials: 'omit', signal: controller.signal });
        if (!res.ok) return;
        for (const line of (await res.text()).split('\n')) {
          const triple = /^<([^>]*)>\s+<([^>]*)>\s+<([^>]*)>\s*\.\s*$/.exec(line.trim());
          if (triple && triple[1] === webId && triple[2] === DELEGATES && triple[3] !== webId && listed.has(triple[3])) {
            agents.add(triple[3]);
          }
        }
      } catch { /* unreadable, timed out: says nothing */ }
    };
    await Promise.all(webIds.filter(ours).slice(0, AGENT_FETCH_MAX).map(read));
    clearTimeout(timer);
    // Never leave the person without a WebID in plain sight.
    if (agents.size === webIds.length) agents.clear();
    return agents;
  }

  // The WebID as a person reads it among six or seven: the pod and the
  // document stand out (key), this server's host, /profile/ and #me are muted
  // (dim), another server's host stays strong (ext), an http:// scheme stays
  // visible in danger, and https:// is dropped. A <wbr> after each "/" lets a
  // line break there and never inside a name.
  // DISPLAY ONLY: the radio's value keeps the full URI, and nothing is derived
  // from this split — a WebID is never parsed for logic.
  function webIdLabel(webId) {
    const label = document.createElement('span');
    label.className = 'webid';
    const part = (text, kind) => {
      const span = document.createElement('span');
      span.className = `webid-${kind}`;
      span.textContent = text;
      label.append(span);
    };
    const wbr = () => label.append(document.createElement('wbr'));

    let url;
    try { url = new URL(webId); } catch { url = null; }
    if (!url || (url.protocol !== 'https:' && url.protocol !== 'http:')) {
      part(webId, 'key'); // not the usual shape: show it whole
      return label;
    }
    if (url.protocol === 'http:') part('http://', 'insecure');
    // A pod is either a subdomain of this server (atelier.example.org/profile/…)
    // or its first folder (example.org/atelier/profile/…). Showing the first
    // shape as "another server" with "profile" as the pod is what the folder-only
    // version did on subdomain pods.
    const onSubdomain = url.host.endsWith(`.${location.host}`);
    if (onSubdomain) {
      part(url.host.slice(0, -location.host.length - 1), 'key');
      part(`.${location.host}/`, 'dim');
    } else {
      part(`${url.host}/`, url.host === location.host ? 'dim' : 'ext');
    }
    wbr();
    const segments = url.pathname.split('/').filter(Boolean);
    segments.forEach((segment, i) => {
      const isPod = i === 0 && !onSubdomain;
      const isDocument = i === segments.length - 1;
      part(segment, isPod || isDocument ? 'key' : 'dim');
      if (!isDocument) {
        part('/', 'dim');
        wbr();
      }
    });
    if (url.search) part(url.search, 'dim');
    if (url.hash) part(url.hash, url.hash === '#me' ? 'dim' : 'key');
    return label;
  }

  // This server's WebIDs first, then by host, pod, the pod's card first, then the rest.
  function sortWebIds(webIds) {
    const keyOf = (webId) => {
      try {
        const url = new URL(webId);
        const segments = url.pathname.split('/').filter(Boolean);
        // On a subdomain pod the path holds no pod name: the host does.
        const ours = url.host === location.host || url.host.endsWith(`.${location.host}`);
        const pod = url.host === location.host ? segments.shift() ?? '' : '';
        const isCard = segments.join('/') === 'profile/card' && url.hash === '#me';
        return [ ours ? 0 : 1, url.host, pod, isCard ? 0 : 1, webId ];
      } catch {
        return [ 2, '', '', 1, webId ];
      }
    };
    return [ ...webIds ].sort((a, b) => {
      const ka = keyOf(a);
      const kb = keyOf(b);
      for (let i = 0; i < ka.length; i++) {
        if (ka[i] < kb[i]) return -1;
        if (ka[i] > kb[i]) return 1;
      }
      return 0;
    });
  }

  function wireButtons(controls) {
    const recoverWebIdLink = document.getElementById('recover-webid');
    elements.cancel.addEventListener('click', async() => {
      const res = await fetch(controls.oidc.cancel, { method: 'POST' });
      location.href = (await res.json()).location;
    });
    setRedirectClick('edit-account', controls.html.account.account);
    elements['switch-account'].addEventListener('click', async() => {
      await fetch(controls.account.logout, { method: 'POST' });
      location.href = controls.html.main.login;
    });

    // CSS 7.3.0 (stock, kept): a broken WebID is repaired before it is used again, so the flow is not
    // resumed here: without a `return` parameter the recovery page goes back to the account page.
    // A link needs a real href: an empty one would navigate to the current page.
    if (controls.html.account?.recoverWebId) {
      recoverWebIdLink.href = controls.html.account.recoverWebId;
    } else {
      setVisibility('recoverWebId', false);
    }
  }

  // Adds client info to the UI. As text: the name and ID come from the app's
  // own client document, so they are never inserted as markup.
  function showClientInfo(label, value) {
    if (value) {
      const dt = document.createElement('dt');
      dt.textContent = label;
      const dd = document.createElement('dd');
      dd.textContent = value;
      elements.client.append(dt, dd);
    }
  }

  // Where the app runs, when this server can vouch for it (solid-kit ADR 010,
  // point 6). CSS 7.2 sends the client's own metadata and no redirect URIs, so
  // a name or a logo proves nothing: any page can call itself "Pod Backoffice".
  // A client_id that is a URL is a Client ID Document: CSS fetched it and
  // sends the sign-in only to the redirect URIs it lists, on that origin, so
  // its host is the one thing worth checking. Any other client_id was handed
  // out on registration to whoever asked. http: counts only on an http: server
  // (a local test); a real instance is https and wants https.
  function clientOrigin(clientId) {
    let url;
    try { url = new URL(clientId); } catch { return null; }
    if (url.protocol === 'https:' || (url.protocol === 'http:' && location.protocol === 'http:')) return url.host;
    return null;
  }

  function showClientOrigin(host) {
    const box = document.getElementById('client-origin');
    const line = document.createElement('p');
    const hint = document.createElement('p');
    hint.className = 'hint';
    if (host) {
      const where = document.createElement('strong');
      where.textContent = host;
      line.append('This app runs at ', where);
      hint.textContent = 'Check this address: your sign-in can only go back there. The name below is the one the app gives itself.';
    } else {
      box.classList.add('unknown');
      line.textContent = 'This app did not say where it runs.';
      hint.textContent = 'The name below is what it calls itself; this server could not check it. Authorize it only if you started this sign-in yourself, from an app you trust.';
    }
    box.replaceChildren(line, hint);
  }

  // Attach client logo to placeholder img
  function showClientLogo(src, alt) {
    if (src) {
      elements.client_logo.src = src
      elements.client_logo.style.visibility = "visible"
    }
    if (alt) {
      elements.client_logo.alt = alt
    }
  }

  async function consent(controls) {
    // The OIDC provider does not allow us to login and consent at the same time, so these have to be separate calls
    const formData = new FormData(elements.mainForm);
    const webId = formData.get('webId');
    let res = await postJson(controls.oidc.webId, { webId });
    let json = await res.json();
    if (res.status !== 200) {
      elements.error.innerText = json.message;
      return;
    }

    // This is required to update the OIDC interaction
    res = await fetch(json.location);
    if (res.status !== 200) {
      json = await res.json();
      elements.error.innerText = json.message;
      return;
    }

    // Submit to the consent API
    res = await postJson(controls.oidc.consent, { remember: Boolean(formData.get('remember')) });
    json = await res.json();
    if (res.status !== 200) {
      elements.error.innerText = json.message;
      return;
    }
    try { localStorage.setItem(LAST_WEBID_KEY, webId); } catch { /* storage blocked */ }
    location.href = json.location;
  }
</script>
