# The public Type Index is readable by anyone (same as wac/): apps find a pod's
# findable data through it.
@prefix acl: <http://www.w3.org/ns/auth/acl#>.
@prefix acp: <http://www.w3.org/ns/solid/acp#>.

<#publicTypeIndex>
    a acp:AccessControlResource;
    acp:resource <./publicTypeIndex.ttl>;
    acp:accessControl <#publicReadAccess>.

<#publicReadAccess>
    a acp:AccessControl;
    acp:apply [
        a acp:Policy;
        acp:allow acl:Read;
        acp:anyOf [
            a acp:Matcher;
            acp:agent acp:PublicAgent
        ]
    ].
