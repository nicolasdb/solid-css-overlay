# Copy to .env (never committed: it is per VPS).

# Names the compose project, the containers (<INSTANCE_NAME>-css,
# <INSTANCE_NAME>-mcp-connector) and the volumes (<INSTANCE_NAME>_css-data).
# Maps of Making: mom-pods, one checkout per function with the mom- prefix.
INSTANCE_NAME=mom-pods

# The image tag, for both images: the same version as the tag this checkout is
# at (git describe --tags). CHANGELOG.md lists them.
CSS_OVERLAY_VERSION=7.2.0-6

# The server, trailing slash included. Pods are <name>.<this host>, so the
# gateway needs this host AND *.<this host> (wildcard certificate, README).
# Chosen once: it is in every WebID.
CSS_BASE_URL=https://pod.example.org/

# The instance's own look: the `pods/` folder of its vertical's design-system
# repo (solid-kit ADR 011; overlay-template/ in solid-css-overlay), checked out
# beside this one. COMPOSE_FILE makes Compose load its compose.override.yml
# after compose.yml; DESIGN_SYSTEM is where that repo is (an absolute path:
# relative ones would resolve from this folder). Leave both commented for the
# generic look.
# COMPOSE_FILE=compose.yml:/srv/mom-design-system/pods/compose.override.yml
# DESIGN_SYSTEM=/srv/mom-design-system

# The external Docker network the gateway (Caddy or nginx) is on.
GATEWAY_NETWORK=gateway

# mcp-connector. It runs only with this line uncommented; without agents,
# leave it commented and docker compose up -d starts CSS alone.
# COMPOSE_PROFILES=connector
# Keep the two lines below set even with the connector off: Compose checks
# every service's required variables, running or not. Example values are fine
# until the connector runs.
MCP_PUBLIC_BASE=https://mcp.pod.example.org/
MCP_ALLOWED_HOSTS=mcp.pod.example.org,pod.example.org
ONBOARD_CORS_ORIGINS=
OXIGRAPH_URL=
