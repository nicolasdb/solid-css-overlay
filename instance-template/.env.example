# Copy to .env (never committed: it is per VPS).

# Names the compose project, the containers (<INSTANCE_NAME>-css,
# <INSTANCE_NAME>-mcp-connector) and the volumes (<INSTANCE_NAME>_css-data).
# Maps of Making: mom-pods, one checkout per function with the mom- prefix.
INSTANCE_NAME=mom-pods

# The image tag, for both images: the same version as the tag this checkout is
# at (git describe --tags). CHANGELOG.md lists them.
CSS_OVERLAY_VERSION=7.2.0-4

# The server, trailing slash included. Pods are <name>.<this host>, so the
# gateway needs this host AND *.<this host> (wildcard certificate, README).
# Chosen once: it is in every WebID.
CSS_BASE_URL=https://pod.example.org/

# The instance's own overlay (overlay-template/ in solid-css-overlay): its own
# repo, checked out beside this one. COMPOSE_FILE makes Compose load its
# compose.override.yml after compose.yml; OVERLAY_DIR is where the files it
# mounts are (an absolute path: relative ones would resolve from this folder).
# Leave both commented for the generic look.
# COMPOSE_FILE=compose.yml:/srv/mom-pods-overlay/compose.override.yml
# OVERLAY_DIR=/srv/mom-pods-overlay/overlay

# The external Docker network the gateway (Caddy or nginx) is on.
GATEWAY_NETWORK=gateway

# mcp-connector (leave empty if the service is removed)
MCP_PUBLIC_BASE=https://mcp.pod.example.org/
MCP_ALLOWED_HOSTS=mcp.pod.example.org,pod.example.org
ONBOARD_CORS_ORIGINS=
OXIGRAPH_URL=
