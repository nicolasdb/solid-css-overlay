# Copy to email.env (never committed), chmod 600: it holds the SMTP password.
# Optional. Without this file, or with SMTP_HOST empty, the server runs without
# mail and "Forgot your password?" answers "No email server is configured."
# Read at every start by the image (start/email.js); after a change:
#   docker compose up -d css
#
# SMTP with STARTTLS only (587 or 2587): CSS's sender cannot be told to use
# implicit TLS, so ports 465 and 2465 do not work.
#
# Resend: host smtp.resend.com, user `resend`, password an API key with
# sending access limited to the sending domain (one key per instance).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
# The From of every mail. Its domain must be one the SMTP service may send
# for (verified at Resend: SPF and DKIM in the zone).
EMAIL_FROM=Maps of Making <pods@mapsofmaking.org>
